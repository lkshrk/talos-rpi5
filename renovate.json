{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "PKG_VERSION = (?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "siderolabs/pkgs",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "TALOS_VERSION = (?<currentValue>.*?)\\n"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "siderolabs/talos",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Talos patch releases: automerge, build + release follows on main",
      "matchPackageNames": [
        "siderolabs/talos"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Talos minor/major: PR for review, bump PKG_VERSION by hand in the same PR",
      "matchPackageNames": [
        "siderolabs/talos"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false
    },
    {
      "description": "pkgs must match the Talos minor (v1.13.x builds on pkgs v1.13.0-*); never bump independently",
      "matchPackageNames": [
        "siderolabs/pkgs"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    }
  ]
}
