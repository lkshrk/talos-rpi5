@@ -0,0 +1,61 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+package sdboot
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+
+	"github.com/siderolabs/talos/pkg/machinery/constants"
+)
+
+func TestConfigureBootSelectionFallsBackToLoaderConfig(t *testing.T) {
+	t.Parallel()
+
+	mountPrefix := t.TempDir()
+	require.NoError(t, os.MkdirAll(filepath.Join(mountPrefix, constants.EFIMountPoint, "loader"), 0o755))
+
+	efiVariablesWritable, err := configureBootSelection(mountPrefix, "Talos-v1.13.7.efi", true, func(string, string) error {
+		return unix.EINVAL
+	})
+	require.NoError(t, err)
+	require.False(t, efiVariablesWritable)
+
+	loaderConfig, err := os.ReadFile(filepath.Join(mountPrefix, constants.EFIMountPoint, "loader", "loader.conf"))
+	require.NoError(t, err)
+	require.Equal(t, "default Talos-v1.13.7.efi\ntimeout 5\n", string(loaderConfig))
+}
+
+func TestConfigureBootSelectionDoesNotFallbackDuringInstall(t *testing.T) {
+	t.Parallel()
+
+	efiVariablesWritable, err := configureBootSelection(t.TempDir(), "Talos-v1.13.7.efi", false, func(string, string) error {
+		return unix.EINVAL
+	})
+	require.ErrorIs(t, err, unix.EINVAL)
+	require.False(t, efiVariablesWritable)
+}
+
+func TestConfigureBootSelectionUsesEFIVariablesWhenWritable(t *testing.T) {
+	t.Parallel()
+
+	var writes []string
+
+	efiVariablesWritable, err := configureBootSelection("", "Talos-v1.13.7.efi", false, func(name, value string) error {
+		writes = append(writes, name+"="+value)
+
+		return nil
+	})
+	require.NoError(t, err)
+	require.True(t, efiVariablesWritable)
+	require.Equal(t, []string{
+		"LoaderEntryDefault=Talos-v1.13.7.efi",
+		"LoaderConfigTimeout=5",
+	}, writes)
+}
