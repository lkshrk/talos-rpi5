+// configureBootSelection preserves strict installation errors, while allowing upgrades
+// and rollback on firmware which rejects nonvolatile EFI variable writes with EINVAL.
+func configureBootSelection(mountPrefix, ukiFileName string, loaderConfigFallback bool, writeVariable func(string, string) error) (bool, error) {
+	if err := writeVariable(LoaderEntryDefaultName, ukiFileName); err != nil {
+		if !loaderConfigFallback || !errors.Is(err, unix.EINVAL) {
+			return false, err
+		}
+
+		loaderConfig := fmt.Sprintf("default %s\ntimeout 5\n", ukiFileName)
+
+		return false, os.WriteFile(filepath.Join(mountPrefix, constants.EFIMountPoint, "loader", "loader.conf"), []byte(loaderConfig), 0o644)
+	}
+
+	return true, writeVariable(LoaderConfigTimeoutName, "5")
+}
+
+// bootDefault honors EFI precedence, then the exact default written by our fallback.
+func bootDefault(mountPrefix, efiDefault string) (string, error) {
+	if efiDefault != "" {
+		return efiDefault, nil
+	}
+
+	data, err := os.ReadFile(filepath.Join(mountPrefix, constants.EFIMountPoint, "loader", "loader.conf"))
+	if errors.Is(err, os.ErrNotExist) {
+		return "", nil
+	}
+	if err != nil {
+		return "", err
+	}
+
+	for line := range strings.SplitSeq(string(data), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 2 && fields[0] == "default" {
+			return fields[1], nil
+		}
+	}
+
+	return "", nil
+}
