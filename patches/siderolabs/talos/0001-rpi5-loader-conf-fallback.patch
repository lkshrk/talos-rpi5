+func TestBootSelectionFallback(t *testing.T) {
+	t.Parallel()
+
+	for _, tt := range []struct {
+		name     string
+		fallback bool
+		writeErr error
+		wantErr  error
+	}{
+		{"upgrade", true, unix.EINVAL, nil},
+		{"install", false, unix.EINVAL, unix.EINVAL},
+		{"unrelated error", true, unix.EIO, unix.EIO},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			prefix := t.TempDir()
+			require.NoError(t, os.MkdirAll(filepath.Join(prefix, constants.EFIMountPoint, "loader"), 0o755))
+			writable, err := configureBootSelection(prefix, "Talos-new.efi", tt.fallback, func(string, string) error { return tt.writeErr })
+			require.ErrorIs(t, err, tt.wantErr)
+			require.False(t, writable)
+			if tt.wantErr == nil {
+				data, err := os.ReadFile(filepath.Join(prefix, constants.EFIMountPoint, "loader", "loader.conf"))
+				require.NoError(t, err)
+				require.Equal(t, "default Talos-new.efi\ntimeout 5\n", string(data))
+			}
+		})
+	}
+}
+
+func TestBootSelectionWritableEFI(t *testing.T) {
+	t.Parallel()
+	var writes []string
+	writable, err := configureBootSelection("", "Talos-new.efi", false, func(name, value string) error {
+		writes = append(writes, name+"="+value)
+		return nil
+	})
+	require.NoError(t, err)
+	require.True(t, writable)
+	require.Equal(t, []string{"LoaderEntryDefault=Talos-new.efi", "LoaderConfigTimeout=5"}, writes)
+
+	_, err = configureBootSelection("", "Talos-new.efi", true, func(name, _ string) error {
+		if name == LoaderConfigTimeoutName {
+			return unix.EIO
+		}
+		return nil
+	})
+	require.ErrorIs(t, err, unix.EIO)
+	_, err = configureBootSelection(t.TempDir(), "Talos-new.efi", true, func(string, string) error { return unix.EINVAL })
+	require.ErrorIs(t, err, os.ErrNotExist)
+}
+
+func TestLoaderConfigDefault(t *testing.T) {
+	t.Parallel()
+	prefix := t.TempDir()
+	entry, err := bootDefault(prefix, "Talos-efi.efi")
+	require.NoError(t, err)
+	require.Equal(t, "Talos-efi.efi", entry)
+	entry, err = bootDefault(prefix, "")
+	require.NoError(t, err)
+	require.Empty(t, entry)
+	require.NoError(t, os.MkdirAll(filepath.Join(prefix, constants.EFIMountPoint, "loader"), 0o755))
+	path := filepath.Join(prefix, constants.EFIMountPoint, "loader", "loader.conf")
+	require.NoError(t, os.WriteFile(path, []byte("# comment\ndefault Talos-new.efi\ntimeout 5\n"), 0o644))
+	entry, err = bootDefault(prefix, "")
+	require.NoError(t, err)
+	require.Equal(t, "Talos-new.efi", entry)
+	entry, err = bootDefault(prefix, "Talos-efi.efi")
+	require.NoError(t, err)
+	require.Equal(t, "Talos-efi.efi", entry)
+}
+
+func TestLoaderConfigPrecleanupAndRollback(t *testing.T) {
+	t.Parallel()
+	prefix := t.TempDir()
+	require.NoError(t, os.MkdirAll(filepath.Join(prefix, constants.EFIMountPoint, "loader"), 0o755))
+	write := func(string, string) error { return unix.EINVAL }
+	// Pre-cleanup and rollback use the same selection operation as upgrade.
+	for _, entry := range []string{"Talos-old.efi", "Talos-new.efi", "Talos-old.efi"} {
+		_, err := configureBootSelection(prefix, entry, true, write)
+		require.NoError(t, err)
+		actual, err := bootDefault(prefix, "")
+		require.NoError(t, err)
+		require.Equal(t, entry, actual)
+		next, ok := findNextBootUKIFile([]string{"Talos-old.efi", "Talos-new.efi"}, actual, "Talos-old.efi")
+		require.True(t, ok)
+		require.Equal(t, entry, next)
+	}
+}
+
+func TestFailedAssetCopyPreservesBootedDefault(t *testing.T) {
+	t.Parallel()
+	prefix := t.TempDir()
+	require.NoError(t, os.MkdirAll(filepath.Join(prefix, constants.EFIMountPoint, "loader"), 0o755))
+	_, err := configureBootSelection(prefix, "Talos-old.efi", true, func(string, string) error { return unix.EINVAL })
+	require.NoError(t, err)
+	config := &Config{BootedEntry: "Talos-old.efi"}
+	err = config.copyAssets(options.InstallOptions{
+		Arch:        "arm64",
+		MountPrefix: prefix,
+		Printf:      func(string, ...any) {},
+		BootAssets:  options.BootAssets{UKIPath: filepath.Join(prefix, "missing.efi")},
+	}, "Talos-new.efi")
+	require.Error(t, err)
+	entry, err := bootDefault(prefix, "")
+	require.NoError(t, err)
+	require.Equal(t, "Talos-old.efi", entry)
+	data, err := os.ReadFile(filepath.Join(prefix, constants.EFIMountPoint, "loader", "loader.conf"))
+	require.NoError(t, err)
+	// Regenerate the normal configuration rather than freezing the old timeout.
+	require.Contains(t, string(data), string(LoaderConfBytes))
+}
