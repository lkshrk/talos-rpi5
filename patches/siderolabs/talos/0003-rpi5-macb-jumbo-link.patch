From 5bd10dd2542e514892320518e29c25dabc667a06 Mon Sep 17 00:00:00 2001
From: lkshrk <lkshrk@users.noreply.github.com>
Date: Sat, 10 Oct 2026 06:27:07 +0200
Subject: [PATCH] udevd: opt-in jumbo MTU link file for the Raspberry Pi 5 RP1
 GEM

---
 Dockerfile                         |  4 ++--
 hack/udevd/10-rpi5-macb-jumbo.link | 12 ++++++++++++
 2 files changed, 14 insertions(+), 2 deletions(-)
 create mode 100644 hack/udevd/10-rpi5-macb-jumbo.link

diff --git a/Dockerfile b/Dockerfile
index df1cf7b..ba8104e 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -826,7 +826,7 @@ COPY --chmod=0644 hack/selinux/virtual_domain_context hack/selinux/virtual_image
 COPY --chmod=0644 hack/containerd.toml /rootfs/etc/containerd/config.toml
 COPY --chmod=0644 hack/cri-containerd.toml /rootfs/etc/cri/containerd.toml
 COPY --chmod=0644 hack/cri-plugin.part /rootfs/etc/cri/conf.d/00-base.part
-COPY --chmod=0644 hack/udevd/99-default.link /rootfs/usr/lib/systemd/network/
+COPY --chmod=0644 hack/udevd/10-rpi5-macb-jumbo.link hack/udevd/99-default.link /rootfs/usr/lib/systemd/network/
 COPY --chmod=0644 hack/udevd/40-vm-hotadd.rules hack/udevd/90-md-raid-arrays.rules hack/udevd/90-md-raid-assembly.rules hack/udevd/90-selinux.rules hack/udevd/99-talos.rules /rootfs/usr/lib/udev/rules.d/
 COPY --chmod=0644 hack/lvm.conf /rootfs/etc/lvm/lvm.conf
 COPY --link --chmod=0644 --from=base /src/pkg/machinery/version/os-release /rootfs/etc/os-release
@@ -917,7 +917,7 @@ COPY --chmod=0644 hack/selinux/virtual_domain_context hack/selinux/virtual_image
 COPY --chmod=0644 hack/containerd.toml /rootfs/etc/containerd/config.toml
 COPY --chmod=0644 hack/cri-containerd.toml /rootfs/etc/cri/containerd.toml
 COPY --chmod=0644 hack/cri-plugin.part /rootfs/etc/cri/conf.d/00-base.part
-COPY --chmod=0644 hack/udevd/99-default.link /rootfs/usr/lib/systemd/network/
+COPY --chmod=0644 hack/udevd/10-rpi5-macb-jumbo.link hack/udevd/99-default.link /rootfs/usr/lib/systemd/network/
 COPY --chmod=0644 hack/udevd/40-vm-hotadd.rules hack/udevd/90-md-raid-arrays.rules hack/udevd/90-md-raid-assembly.rules hack/udevd/90-selinux.rules hack/udevd/99-talos.rules /rootfs/usr/lib/udev/rules.d/
 COPY --chmod=0644 hack/lvm.conf /rootfs/etc/lvm/lvm.conf
 COPY --link --chmod=0644 --from=base /src/pkg/machinery/version/os-release /rootfs/etc/os-release
diff --git a/hack/udevd/10-rpi5-macb-jumbo.link b/hack/udevd/10-rpi5-macb-jumbo.link
new file mode 100644
index 0000000..4732f8a
--- /dev/null
+++ b/hack/udevd/10-rpi5-macb-jumbo.link
@@ -0,0 +1,12 @@
+# macb (RP1 GEM) rejects MTU changes on a running link; udevd sets it at device add, before Talos raises the link.
+# Opt-in: only applies when the kernel command line contains talos_rpi5.macb_jumbo.
+
+[Match]
+Driver=macb
+KernelCommandLine=talos_rpi5.macb_jumbo
+
+[Link]
+MTUBytes=9000
+NamePolicy=keep kernel database onboard slot path mac
+AlternativeNamesPolicy=database onboard slot path mac
+MACAddressPolicy=none
-- 
